# Copy to .env and fill in. Never commit .env.
# Use the dev key from the specs-dev workspace in the Claude Console (not the specs-prod key Netlify uses).
ANTHROPIC_API_KEY=

# Cloudflare's published test keys: the check always passes. Fine for local work only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Guards (see docs/spec.md, "Architecture, cost and guardrails")
GENERATION_ENABLED=true
DAILY_SPEND_CAP_USD=1.50
IP_HASH_SALT=any-long-random-string

# Local only: keep sessions and spend in memory instead of Netlify Blobs. Ignored on Netlify.
SPECS_STORE=memory

# Image-model spike only (spike/sketch.ts). A Gemini API key from Google AI Studio, with billing on.
# The app never reads it.
GEMINI_API_KEY=
