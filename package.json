{
  "name": "specs",
  "version": "0.1.0",
  "private": true,
  "description": "Turns messy brand materials into an agent-readable brand kit, then art-directs on-brand Instagram posts that explain their decisions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc",
    "spike": "tsx --env-file=.env",
    "tokens": "tsx spike/build-tokens.ts",
    "samples": "tsx spike/render-samples.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
