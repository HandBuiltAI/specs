{
  "name": "specs",
  "version": "0.1.0",
  "private": true,
  "description": "Turns messy brand materials into an agent-readable brand kit, then art-directs on-brand Instagram posts that explain their decisions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run content && next dev",
    "build": "npm run content && npm run typecheck && next build",
    "start": "next start",
    "content": "tsx scripts/bundle-content.ts",
    "typecheck": "tsc",
    "spike": "tsx --env-file=.env",
    "tokens": "tsx spike/build-tokens.ts",
    "samples": "tsx spike/render-samples.ts",
    "review": "tsx spike/review.ts",
    "review-extract": "tsx spike/review-extract.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "npm run content && tsx --conditions=react-server --test tests/*.test.ts",
    "gate": "tsx scripts/check-gate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@netlify/blobs": "^11.1.7",
    "geist": "1.8.2",
    "html-to-image": "1.11.13",
    "jszip": "3.10.1",
    "next": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
